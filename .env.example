# Copy to .env — used by docker compose --env-file (never bash-source).

COMPOSE_PROJECT_NAME=customer-club-obs

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Host ports chosen to avoid Customer Club local-dev (3000/3001/3002/8081/8082/5342).
GRAFANA_PORT=3300
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
ALERTMANAGER_PORT=9093
COLLECTOR_PROM_PORT=9464

# When profile "probe-apps" is on, blackbox hits these on the laptop.
APP_ADMIN_HEALTH_URL=http://host.docker.internal:8081/healthz
APP_CUSTOMER_HEALTH_URL=http://host.docker.internal:8082/healthz
APP_ADMIN_UI_URL=http://host.docker.internal:3001/
APP_CUSTOMER_UI_URL=http://host.docker.internal:3000/
APP_SQL_TARGET=host.docker.internal:15433
